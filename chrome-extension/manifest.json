{
  "manifest_version": 3,
  "name": "AI 即時翻譯－網頁字幕",
  "short_name": "AI 翻譯字幕",
  "version": "0.2.0",
  "description": "YouTube 字幕優先、分頁音訊備援，使用家庭 AI 翻譯服務顯示繁體中文字幕。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "identity",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "https://mflhfttirywdsqvjhvhl.supabase.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI 即時翻譯－網頁字幕",
    "default_popup": "popup.html"
  }
}
